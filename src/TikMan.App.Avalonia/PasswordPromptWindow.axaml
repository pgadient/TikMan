<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TikMan.App.Avalonia"
        x:Class="TikMan.App.Avalonia.PasswordPromptWindow"
        x:CompileBindings="False"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/tikman.png"
        Title="{loc:Loc Av_Password}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="PassBox" PasswordChar="●" RevealPassword="{Binding #Reveal.IsChecked}" KeyDown="OnKey" />
        <CheckBox x:Name="Reveal" Content="{loc:Loc Av_Show}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{loc:Loc Av_Cancel}" Click="OnCancel" Classes="action" />
            <Button Content="{loc:Loc Av_Ok}" Click="OnOk" Classes="action" />
        </StackPanel>
    </StackPanel>
</Window>
