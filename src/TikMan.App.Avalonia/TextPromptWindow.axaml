<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TikMan.App.Avalonia"
        x:Class="TikMan.App.Avalonia.TextPromptWindow"
        x:CompileBindings="False"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/tikman.png"
        Title="TikMan">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" KeyDown="OnKey" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{loc:Loc Av_Cancel}" Click="OnCancel" IsCancel="True" Classes="action" />
            <Button Content="{loc:Loc Av_Ok}" Click="OnOk" Classes="action" />
        </StackPanel>
    </StackPanel>
</Window>
