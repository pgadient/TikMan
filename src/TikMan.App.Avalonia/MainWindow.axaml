<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TikMan.App.Avalonia.MainWindow"
        x:CompileBindings="False"
        Width="1120" Height="720"
        Icon="/Assets/tikman.png"
        Title="TikMan">
    <Window.Styles>
        <!-- A classic, clearly-tabbed look instead of Fluent's flat/oversized default: normal-size,
             bordered tab headers with a raised selected tab, and a framed content area (added on the
             Border around the TabControl below). -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#50808080" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#3AFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#28808080" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                      Width="240" MinWidth="180" VerticalAlignment="Center" />
            <TextBox Text="{Binding ScanRange, Mode=TwoWay}" Watermark="z. B. 192.168.8.0/21"
                     Width="180" VerticalAlignment="Center" />
            <Button Content="Scannen" Click="OnScanClick" IsEnabled="{Binding CanScan}" />
            <Button Content="⚙" Click="OnSettingsClick" ToolTip.Tip="Einstellungen" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Border BorderBrush="#50808080" BorderThickness="1" CornerRadius="4" Padding="0">
        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged" Background="Transparent">
            <!-- Geräte -->
            <TabItem Header="Geräte">
                <Grid ColumnDefinitions="*,Auto">
                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="Auto" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding KindText}" Width="Auto" />
                            <DataGridTextColumn Header="Hersteller" Binding="{Binding Vendor}" Width="1.4*" />
                            <DataGridTextColumn Header="Modell" Binding="{Binding Model}" Width="1.6*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Width="340" Margin="16,0,0,0" Padding="16"
                            IsVisible="{Binding HasSelection}"
                            Background="#14808080" CornerRadius="10">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDevice.KindText}" Opacity="0.7" />

                                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,6,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Opacity="0.6" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.Ip}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC" Opacity="0.6" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Mac}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hersteller" Opacity="0.6" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.Vendor}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Modell" Opacity="0.6" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.Model}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Opacity="0.6" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.Status}" />
                                </Grid>

                                <!-- IPv6-Adressen (falls vorhanden). -->
                                <StackPanel IsVisible="{Binding SelectedDevice.HasIpv6}" Margin="0,4,0,0">
                                    <TextBlock Text="IPv6" Opacity="0.6" />
                                    <ItemsControl ItemsSource="{Binding SelectedDevice.Ipv6}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid ColumnDefinitions="90,*" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="Anmeldung" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.User}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Content="Anmelden…" Click="OnLoginClick" />
                                    <Button Content="Backup…" Click="OnBackupClick" IsEnabled="{Binding CanBackup}"
                                            ToolTip.Tip="Konfiguration sichern (RouterOS/Zyxel-Switch, benötigt Login)" />
                                    <Button Content="Wake-on-LAN" Click="OnWakeClick" IsEnabled="{Binding CanWake}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionResult}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />

                                <ItemsControl ItemsSource="{Binding SelectedDevice.Info}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="130,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Opacity="0.6" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Topologie (logisch) -->
            <TabItem Header="Karte (logisch)">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="LogicalCanvas" Background="Transparent" />
                </ScrollViewer>
            </TabItem>

            <!-- Topologie (physisch) -->
            <TabItem Header="Karte (physisch)">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="PhysicalCanvas" Background="Transparent" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Border>
    </DockPanel>
</Window>
