<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TikMan.App.Avalonia.MainWindow"
        x:CompileBindings="False"
        Width="1120" Height="720"
        Title="TikMan">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="TikMan" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Scannen" Click="OnScanClick" IsEnabled="{Binding CanScan}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
            <!-- Geräte -->
            <TabItem Header="Geräte">
                <Grid ColumnDefinitions="*,Auto">
                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="Auto" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding KindText}" Width="Auto" />
                            <DataGridTextColumn Header="Hersteller" Binding="{Binding Vendor}" Width="1.4*" />
                            <DataGridTextColumn Header="Modell" Binding="{Binding Model}" Width="1.6*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Width="340" Margin="16,0,0,0" Padding="16"
                            IsVisible="{Binding HasSelection}"
                            Background="#14808080" CornerRadius="10">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDevice.KindText}" Opacity="0.7" />

                                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,6,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Opacity="0.6" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.Ip}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC" Opacity="0.6" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Mac}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hersteller" Opacity="0.6" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.Vendor}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Modell" Opacity="0.6" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.Model}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Opacity="0.6" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.Status}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Content="Wake-on-LAN" Click="OnWakeClick" IsEnabled="{Binding CanWake}" />
                                    <TextBlock Text="{Binding ActionResult}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding SelectedDevice.Info}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="130,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Opacity="0.6" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Topologie (logisch) -->
            <TabItem Header="Karte (logisch)">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="LogicalCanvas" Background="Transparent" />
                </ScrollViewer>
            </TabItem>

            <!-- Topologie (physisch) -->
            <TabItem Header="Karte (physisch)">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="PhysicalCanvas" Background="Transparent" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
