<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:TikMan.App.Avalonia"
        x:Class="TikMan.App.Avalonia.TerminalWindow"
        x:CompileBindings="False"
        Width="860" Height="560"
        Icon="/Assets/tikman.png"
        Title="{loc:Loc Av_TerminalTitle}">
    <DockPanel Margin="10">
        <TextBox DockPanel.Dock="Bottom" x:Name="Input" Margin="0,8,0,0"
                 PlaceholderText="{loc:Loc Av_TerminalPrompt}"
                 FontFamily="Consolas, Menlo, monospace" KeyDown="OnInputKey" />
        <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas, Menlo, monospace" FontSize="13"
                 Background="#0F1419" Foreground="#DCE3EA"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
