<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="TikMan.App.Avalonia.App"
             RequestedThemeVariant="Default">
    <!-- Semi.Avalonia theme (modern, cross-platform, follows the OS light/dark variant). The DataGrid
         theme is a separate include; the DataGrid control itself still comes from Avalonia.Controls.DataGrid. -->
    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <semi:DataGridSemiTheme />
        <!-- ⚠️ Semi's DataGrid uses FLOATING (overlay) scrollbars: even with ScrollViewer.AllowAutoHide=False
             the horizontal bar floats over the bottom rows and the vertical bar over the last column. When the
             list is maximised AND has more rows than fit, the h-bar lands on top of the last (partial) row and
             is all but invisible – it reads as "the scrollbar is gone in fullscreen". The earlier fixes did
             nothing: AllowAutoHide=False only stops the FADE, not the overlay, and the `#PART_RowsPresenter`
             bottom-margin setter was a plain no-op (verified in a minimal repro – identical with and without it).
             The fix is a custom ControlTemplate that pulls both scrollbars OUT of the table frame, Win32-style:
             the BorderBrush frame wraps ONLY the data (column headers + rows); the vertical bar sits in its own
             column to the RIGHT of the frame and the horizontal bar in its own row BELOW the frame. So they
             RESERVE space, never overlap the table, and are plainly visible in their own gutters (Semi's bars
             tucked inside the frame were almost invisible). All visual styling still comes from Semi's
             type-selector styles on the header / row / cell / scrollbar parts; only the parts' PLACEMENT changes.
             Reproduced against a 15-column DataGrid under Semi 12.1. -->
        <Style Selector="DataGrid">
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Outer grid: data-frame (0,0) + vertical bar gutter (col 1) + horizontal bar gutter (row 1). -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                        <Border Grid.Row="0" Grid.Column="0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
                                <DataGridColumnHeader Name="PART_TopLeftCornerHeader" Grid.Row="0" Grid.Column="0" />
                                <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter"
                                    Grid.Row="0" Grid.Column="1" />
                                <Rectangle Name="PART_ColumnHeadersAndRowsSeparator" Grid.Row="0" Grid.Column="0"
                                    Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
                                    Fill="{DynamicResource DataGridGridLinesBrush}" />
                                <DataGridRowsPresenter Name="PART_RowsPresenter"
                                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
                            </Grid>
                        </Border>
                        <ScrollBar Name="PART_VerticalScrollbar" Orientation="Vertical"
                            Grid.Row="0" Grid.Column="1" Width="14" />
                        <!-- ⚠️ Fixed Height on this row: PART_FrozenColumnScrollBarSpacer is a DataGridColumnHeader
                             whose default height (~36 px) would inflate the row and leave a gap ABOVE the
                             14 px h-scrollbar (the vertical bar has no such spacer, so it was already flush).
                             Pinning the row to the scrollbar's height makes the h-bar sit flush against the grid. -->
                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*" Height="14">
                            <DataGridColumnHeader Name="PART_FrozenColumnScrollBarSpacer" Grid.Column="0" />
                            <ScrollBar Name="PART_HorizontalScrollbar" Grid.Column="1"
                                Orientation="Horizontal" Height="14" />
                        </Grid>
                        <Rectangle Name="PART_BottomRightCorner" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Classic Win32-style scrollbar for the DataGrid: single-step arrow buttons at the two ends
             (PART_LineUpButton / PART_LineDownButton, wired by the ScrollBar itself), then a faint track with a
             solid handle in the middle. The handle drags 1:1 and a click on the track pages. ⚠️ The Track MUST
             carry its DecreaseButton and IncreaseButton: without them the thumb is mis-sized and the drag is not
             1:1 (that was the "can't drag it properly" bug). Solid handle, no grip lines (they read cheap); the
             track and handle sit flush against the grid; AllowAutoHide=False keeps it steady and the DataGrid
             shows/hides the whole bar by content. -->
        <Style Selector="DataGrid /template/ ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <!-- Whole-bar hover: the pointer anywhere over the scrollbar lifts every part one shade (faint track,
             arrow boxes, and the solid handle) – the classic subtle scrollbar hover. The arrow boxes otherwise
             share the track's faint fill (no visible box/seam); pressing an arrow flashes it darker still.
             ⚠️ Each hop crosses ONE template boundary, so the arrow Border needs three /template/ hops
             (DataGrid → ScrollBar → RepeatButton → its Border); a plain descendant combinator would not reach in. -->
        <Style Selector="DataGrid /template/ ScrollBar:pointerover:not(.dragging) /template/ Border.trackband">
            <Setter Property="Background" Value="#40808080" />
        </Style>
        <Style Selector="DataGrid /template/ ScrollBar:pointerover:not(.dragging) /template/ RepeatButton.scrollarrow /template/ Border">
            <Setter Property="Background" Value="#40808080" />
        </Style>
        <Style Selector="DataGrid /template/ ScrollBar:pointerover:not(.dragging) /template/ Thumb /template/ Border">
            <Setter Property="Background" Value="#79808A" />
        </Style>
        <Style Selector="RepeatButton.scrollarrow:pressed /template/ Border">
            <Setter Property="Background" Value="#66808080" />
        </Style>
        <Style Selector="DataGrid /template/ ScrollBar:vertical">
            <Setter Property="Width" Value="14" />
            <!-- ⚠️ Track-click pages by LargeChange (LargeDecrement does Value -= LargeChange). The DataGrid
                 leaves the vertical bar's LargeChange at its tiny default, so a track click crept one row
                 instead of a page (the horizontal bar gets a viewport-sized LargeChange and paged fine). Bind
                 it to the bar's own ViewportSize so one click moves a full visible page. ⚠️ This does NOT
                 affect the thumb drag (the earlier drift was the thumb's main-axis margin, since moved to the
                 track); the drag stayed broken even with this reverted, so it is safe here. -->
            <Setter Property="LargeChange" Value="{Binding ViewportSize, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- ▲ [ faint track + handle ] ▼  – track in the middle; a SQUARE 14x14 arrow button at each
                         end (14 = the bar's width, so the buttons are as wide as the bar). -->
                    <Grid RowDefinitions="14,*,14">
                        <RepeatButton Classes="scrollarrow" Name="PART_LineUpButton" Grid.Row="0" Background="Transparent" Margin="0" Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <RepeatButton.Template>
                                <ControlTemplate>
                                    <Border Background="#1E808080">
                                        <Path Data="M 2,9 L 7,4 L 12,9 Z" Fill="#5C636E"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,6" />
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <Border Grid.Row="1" Classes="trackband" Background="#1E808080">
                            <Track Orientation="Vertical" IsDirectionReversed="True" Margin="0,3"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="0" MinHeight="0" Margin="0" Padding="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Margin="2,0">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="#8A9099" CornerRadius="2"
                                                        BorderBrush="#5C636E" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="0" MinHeight="0" Margin="0" Padding="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseButton>
                            </Track>
                        </Border>
                        <RepeatButton Classes="scrollarrow" Name="PART_LineDownButton" Grid.Row="2" Background="Transparent" Margin="0" Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <RepeatButton.Template>
                                <ControlTemplate>
                                    <Border Background="#1E808080">
                                        <Path Data="M 2,4 L 12,4 L 7,9 Z" Fill="#5C636E"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,3" />
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DataGrid /template/ ScrollBar:horizontal">
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- ◄ [ faint track + handle ] ►  – the grey track in the middle; a SQUARE 14x14 arrow button
                         at each end (14 = the bar's height). 2 px right margin so it clears the vertical bar. -->
                    <Grid ColumnDefinitions="14,*,14">
                        <RepeatButton Classes="scrollarrow" Name="PART_LineUpButton" Grid.Column="0" Background="Transparent" Margin="0" Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <RepeatButton.Template>
                                <ControlTemplate>
                                    <Border Background="#1E808080">
                                        <Path Data="M 9,2 L 4,7 L 9,12 Z" Fill="#5C636E"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,7,4" />
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <Border Grid.Column="1" Classes="trackband" Background="#1E808080">
                            <Track Orientation="Horizontal" IsDirectionReversed="False" Margin="3,0"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="0" MinHeight="0" Margin="0" Padding="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseButton>
                                <Track.Thumb>
                                    <Thumb MinWidth="28" Margin="0,2">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="#8A9099" CornerRadius="2"
                                                        BorderBrush="#5C636E" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="0" MinHeight="0" Margin="0" Padding="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseButton>
                            </Track>
                        </Border>
                        <RepeatButton Classes="scrollarrow" Name="PART_LineDownButton" Grid.Column="2" Background="Transparent" Margin="0" Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <RepeatButton.Template>
                                <ControlTemplate>
                                    <Border Background="#1E808080">
                                        <Path Data="M 5,2 L 10,7 L 5,12 Z" Fill="#5C636E"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- The action button: a light plate with dark ink, readable in both theme variants where the
             theme's own pale accent was not.
             ⚠️ Defined once here, application-wide. It used to be copied into each view's own
             UserControl.Styles, so a window that forgot the copy silently got the default look – which is
             how the topology, update and MAC-vendor buttons ended up differing from everything else. -->
        <!-- ⚠️ `:is(Button)`, not `Button`: an Avalonia type selector matches that type EXACTLY, so a plain
             `Button.action` silently skips ToggleButton (which derives from Button) – the detail-pane
             chevron would keep the theme's own look while everything beside it changed. -->
        <Style Selector=":is(Button).action">
            <Setter Property="Background" Value="#C9CCD1" />
            <Setter Property="Foreground" Value="#101010" />
        </Style>
        <!-- A glyph inside an action button inherits the same ink as its label. -->
        <Style Selector=":is(Button).action Path">
            <Setter Property="Fill" Value="#101010" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- White text on the (saturated blue) selected row, so the row reads clearly when highlighted. -->
        <Style Selector="DataGridRow:selected DataGridCell TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- …but keep the per-row channel ComboBox's own text dark (it sits on its own light box, not on the
             blue), so it stays readable. More specific selector, so it wins for the combo's inner text. -->
        <Style Selector="DataGridRow:selected DataGridCell ComboBox TextBlock">
            <Setter Property="Foreground" Value="#101010" />
        </Style>

        <!-- ⚠️ Grid selection checkbox: a plain black-on-white box, its own self-contained template, so it is
             clearly visible BOTH on a white row and on the blue selected row. Semi's default check is a pale
             tint that vanished on both. White box + dark border + dark check reads on either background.
             Scoped to checkboxes INSIDE a DataGrid cell, so the option checkboxes elsewhere keep the theme. -->
        <Style Selector="DataGrid DataGridCell CheckBox">
            <!-- Hand cursor over the tick box, so it reads as clickable. -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="16" Height="16" CornerRadius="3.5" Background="White"
                            BorderBrush="#3C3C3C" BorderThickness="1.3"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Viewbox = the check is scaled proportionally and centred, whatever the geometry
                             coordinates are, so it always sits neatly in the box. Slight top nudge because a
                             checkmark looks centred a hair below the true middle. -->
                        <Viewbox Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="0,0.5,0,0">
                            <Path Name="Check" Data="M0,4.2 L3.2,7.4 L9,1" Stroke="#141414" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" IsVisible="False" />
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DataGrid DataGridCell CheckBox:checked /template/ Path#Check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Application.Styles>

    <!-- Two-tone button glyphs: the icon is drawn in the theme's ink (black on light, white on dark) on the
         button's own pastel fill, so the same markup reads correctly in both variants. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GlyphBrush" Color="#1A1A1A" />
                    <!-- Feedback trio: pale pastels on a light background. -->
                    <SolidColorBrush x:Key="ReportBrush" Color="#FFE2C2" />
                    <SolidColorBrush x:Key="FeatureBrush" Color="#CFE3F7" />
                    <SolidColorBrush x:Key="CoffeeBrush" Color="#E6D3BC" />
                    <SolidColorBrush x:Key="FeedbackInkBrush" Color="#2A2A2A" />
                    <!-- Sign-in hint: parchment with brown ink, the same palette as the WPF client. -->
                    <SolidColorBrush x:Key="HintBrush" Color="#FBF3DC" />
                    <SolidColorBrush x:Key="HintBorderBrush" Color="#EAD9A6" />
                    <SolidColorBrush x:Key="HintInkBrush" Color="#7A5C10" />
                    <SolidColorBrush x:Key="HintLinkBrush" Color="#5C6BC0" />
                    <!-- Map "working on it" / error card: nearly opaque so the message reads clearly over the
                         map behind it (the old 8%-alpha grey was almost invisible). A hair of translucency
                         (0xF2 ≈ 95%) keeps a hint of the map showing through. -->
                    <SolidColorBrush x:Key="OverlayCardBrush" Color="#F2F6F7F9" />
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#D2D7DE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GlyphBrush" Color="#F2F2F2" />
                    <!-- ⚠️ On dark, a pale pastel glares. These come DOWN from the saturated hue instead:
                         mid-tone and still unmistakably coloured (never near-black), which keeps the usual
                         dark-grey ink readable on them – so the trio uses that ink in both variants rather
                         than flipping to white, which would smear on a mid-tone fill. -->
                    <SolidColorBrush x:Key="ReportBrush" Color="#C98A45" />
                    <SolidColorBrush x:Key="FeatureBrush" Color="#5E8FC4" />
                    <SolidColorBrush x:Key="CoffeeBrush" Color="#A67C52" />
                    <SolidColorBrush x:Key="FeedbackInkBrush" Color="#2A2A2A" />
                    <!-- ⚠️ The hint inverts rather than dims. Parchment is a large, bright area – on a dark
                         window it is the one thing that glares, and it sits above the list the user is
                         reading. So: deep brown ground with amber ink, the same warm hue at the opposite
                         end of the scale, keeping the "this is a notice" reading without the flashbang. -->
                    <SolidColorBrush x:Key="HintBrush" Color="#3A2E14" />
                    <SolidColorBrush x:Key="HintBorderBrush" Color="#5C4A20" />
                    <SolidColorBrush x:Key="HintInkBrush" Color="#F0C860" />
                    <SolidColorBrush x:Key="HintLinkBrush" Color="#9FB3E8" />
                    <!-- Dark-theme counterpart: near-opaque dark card so the (light) text stays readable. -->
                    <SolidColorBrush x:Key="OverlayCardBrush" Color="#F22B2E33" />
                    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#454A52" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ⚠️ DataGrid selection colour. Semi's default selected row is a very pale blue that reads as
                 "nothing is selected" – and it fades further when a ▲▼ button takes focus off the grid. These
                 are the resource keys Semi's DataGrid row theme binds its selection fill to (overriding the
                 keys is the way that works; a template-part selector for a part the theme lacks fails silently).
                 A clear Windows-accent blue in every state (focused, unfocused, hovered), so a selected row is
                 unmistakable – which is what the ▲▼ / drag reordering needs to be legible. -->
            <SolidColorBrush x:Key="DataGridRowSelectedBackground" Color="#4A90D9" />
            <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackground" Color="#4A90D9" />
            <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground" Color="#3A80C9" />
            <SolidColorBrush x:Key="DataGridRowSelectedPointeroverUnfocusedBackground" Color="#3A80C9" />

            <!-- Button glyphs as path geometry, not emoji: an emoji is drawn by the OS colour font and can
                 neither be tinted nor follow the light/dark variant. A Path fills with GlyphBrush, so every
                 icon is genuinely monochrome and flips black/white with the theme. All drawn on a 14×14 box. -->
            <StreamGeometry x:Key="IconBug">M7 1.4 C8.6 1.4 9.9 2.7 9.9 4.3 L4.1 4.3 C4.1 2.7 5.4 1.4 7 1.4 Z M3.3 5.5 L10.7 5.5 C11.2 6.5 11.5 7.7 11.5 9 C11.5 11.2 9.5 12.9 7 12.9 C4.5 12.9 2.5 11.2 2.5 9 C2.5 7.7 2.8 6.5 3.3 5.5 Z M0.7 6.6 L2.2 7.2 L1.9 8.3 L0.4 7.8 Z M13.3 6.6 L13.6 7.8 L12.1 8.3 L11.8 7.2 Z M0.9 11.4 L2.3 10.4 L2.9 11.4 L1.5 12.4 Z M13.1 11.4 L12.5 12.4 L11.1 11.4 L11.7 10.4 Z</StreamGeometry>
            <StreamGeometry x:Key="IconBulb">M7 0.8 C9.5 0.8 11.4 2.7 11.4 5.1 C11.4 6.7 10.6 7.9 9.7 8.9 C9.2 9.4 8.9 9.9 8.8 10.5 L5.2 10.5 C5.1 9.9 4.8 9.4 4.3 8.9 C3.4 7.9 2.6 6.7 2.6 5.1 C2.6 2.7 4.5 0.8 7 0.8 Z M5.3 11.5 L8.7 11.5 L8.7 12.4 L5.3 12.4 Z M5.9 13.2 L8.1 13.2 L7.6 13.9 L6.4 13.9 Z</StreamGeometry>
            <StreamGeometry x:Key="IconCoffee">M1.8 3.4 L10 3.4 L10 8.6 C10 10.4 8.6 11.8 6.8 11.8 L5 11.8 C3.2 11.8 1.8 10.4 1.8 8.6 Z M10.6 4.6 L11.6 4.6 C12.7 4.6 13.5 5.4 13.5 6.5 C13.5 7.6 12.7 8.4 11.6 8.4 L10.6 8.4 L10.6 7.2 L11.6 7.2 C12 7.2 12.3 6.9 12.3 6.5 C12.3 6.1 12 5.8 11.6 5.8 L10.6 5.8 Z M1.2 12.8 L10.6 12.8 L10.6 13.9 L1.2 13.9 Z M3.6 0.3 L4.5 0.3 L4.5 2.3 L3.6 2.3 Z M6 0.3 L6.9 0.3 L6.9 2.3 L6 2.3 Z M8.4 0.3 L9.3 0.3 L9.3 2.3 L8.4 2.3 Z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M6 0.8 C8.9 0.8 11.2 3.1 11.2 6 C11.2 7.2 10.8 8.3 10.1 9.2 L13.4 12.5 L12.5 13.4 L9.2 10.1 C8.3 10.8 7.2 11.2 6 11.2 C3.1 11.2 0.8 8.9 0.8 6 C0.8 3.1 3.1 0.8 6 0.8 Z M6 2.2 C3.9 2.2 2.2 3.9 2.2 6 C2.2 8.1 3.9 9.8 6 9.8 C8.1 9.8 9.8 8.1 9.8 6 C9.8 3.9 8.1 2.2 6 2.2 Z</StreamGeometry>
            <StreamGeometry x:Key="IconKey">M9.2 0.8 C11.8 0.8 13.9 2.9 13.9 5.5 C13.9 8.1 11.8 10.2 9.2 10.2 C8.5 10.2 7.9 10.1 7.3 9.8 L6.2 10.9 L4.8 10.9 L4.8 12.3 L3.4 12.3 L3.4 13.7 L0.6 13.7 L0.6 11.4 L4.9 7.1 C4.6 6.6 4.5 6.1 4.5 5.5 C4.5 2.9 6.6 0.8 9.2 0.8 Z M10.2 3 C9.5 3 9 3.5 9 4.2 C9 4.9 9.5 5.4 10.2 5.4 C10.9 5.4 11.4 4.9 11.4 4.2 C11.4 3.5 10.9 3 10.2 3 Z</StreamGeometry>
            <StreamGeometry x:Key="IconPower">M6.3 0.6 L7.7 0.6 L7.7 7 L6.3 7 Z M3.5 2.4 L4.4 3.5 C3.1 4.4 2.3 5.9 2.3 7.6 C2.3 10.2 4.4 12.3 7 12.3 C9.6 12.3 11.7 10.2 11.7 7.6 C11.7 5.9 10.9 4.4 9.6 3.5 L10.5 2.4 C12.1 3.6 13.1 5.5 13.1 7.6 C13.1 11 10.4 13.7 7 13.7 C3.6 13.7 0.9 11 0.9 7.6 C0.9 5.5 1.9 3.6 3.5 2.4 Z</StreamGeometry>
            <StreamGeometry x:Key="IconSun">M7 3.6 C8.9 3.6 10.4 5.1 10.4 7 C10.4 8.9 8.9 10.4 7 10.4 C5.1 10.4 3.6 8.9 3.6 7 C3.6 5.1 5.1 3.6 7 3.6 Z M6.4 0.2 L7.6 0.2 L7.6 2.4 L6.4 2.4 Z M6.4 11.6 L7.6 11.6 L7.6 13.8 L6.4 13.8 Z M0.2 6.4 L2.4 6.4 L2.4 7.6 L0.2 7.6 Z M11.6 6.4 L13.8 6.4 L13.8 7.6 L11.6 7.6 Z M2 2.8 L2.8 2 L4.4 3.6 L3.6 4.4 Z M9.6 10.4 L10.4 9.6 L12 11.2 L11.2 12 Z M11.2 2 L12 2.8 L10.4 4.4 L9.6 3.6 Z M2.8 12 L2 11.2 L3.6 9.6 L4.4 10.4 Z</StreamGeometry>
            <StreamGeometry x:Key="IconMoon">M9.3 0.6 C7.6 1.8 6.5 3.8 6.5 6.1 C6.5 9.8 9.5 12.8 13.2 12.8 C13.4 12.8 13.6 12.8 13.8 12.8 C12.5 13.5 11 13.9 9.4 13.9 C5.1 13.9 1.6 10.4 1.6 6.1 C1.6 3.3 3.1 0.9 5.4 -0.4 C6.6 0 8 0.2 9.3 0.6 Z</StreamGeometry>
