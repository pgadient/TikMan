<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TikMan</AssemblyName>
    <RootNamespace>TikMan.App</RootNamespace>
    <ApplicationIcon>tikman.ico</ApplicationIcon>
    <!-- Build number auto-increments: 1.1.<days since 2026-01-01> (recomputed on every build). -->
    <Version>2.3.3</Version>
    <Product>TikMan</Product>
    <Company>Pascal Montico-Gadient</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TikMan.Core\TikMan.Core.csproj" />
    <!-- The web server lives in its own UI-free assembly (shared with the headless TikMan.Host);
         it brings its own embedded xterm/noVNC assets. -->
    <ProjectReference Include="..\TikMan.Web\TikMan.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded VNC viewer: MarcusW.VncClient RFB client (MIT). Negotiates RFB 3.3/3.7/3.8, so it
         reaches older VNC servers too. The framebuffer is rendered into a WPF WriteableBitmap. -->
    <PackageReference Include="Community.MarcusW.VncClient" Version="2.0.4" />
    <!-- Vector PDF export of the topology graphs. PdfSharp is MIT-licensed, pure managed C# and has
         been the go-to .NET PDF library for ~20 years. -->
    <PackageReference Include="PdfSharp" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="tikman.png" />
  </ItemGroup>

  <!-- LocalizationManager/Strings moved to TikMan.Core.Localization (shared with Avalonia/Web). This
       global using keeps the existing WPF code (`LocalizationManager…`, and the `{loc:Loc}` markup that
       still lives in TikMan.App.Localization) resolving without touching every file. -->
  <ItemGroup>
    <Using Include="TikMan.Core.Localization" />
  </ItemGroup>

</Project>
