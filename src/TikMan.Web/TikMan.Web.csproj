<Project Sdk="Microsoft.NET.Sdk">

  <!-- The built-in web server, extracted from TikMan.App so it has NO WPF/Windows dependency and can
       be hosted headless (TikMan.Host) on Linux/macOS as well as inside the WPF app on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TikMan.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TikMan.Core\TikMan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Browser terminal (xterm.js, MIT) served by the web server; embedded so it ships inside the
         single-file build. -->
    <EmbeddedResource Include="assets\xterm.js" />
    <EmbeddedResource Include="assets\xterm.css" />
    <EmbeddedResource Include="assets\xterm-addon-fit.js" />
    <!-- Browser VNC client (noVNC, MPL-2.0) as a self-contained ES-module bundle. -->
    <EmbeddedResource Include="assets\novnc.js" />
  </ItemGroup>

</Project>
